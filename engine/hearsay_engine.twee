:: StoryInit
<<set $questionsLeft to setup.scenario.budget>>
<<set $asked to {}>>
<<set $closed to []>>
<<set $closedReason to {}>>
<<set $followUpUsed to {}>>
<<set $followUpOrder to {}>>
<<set $majorClues to 0>>
<<set $notebook to []>>
<<set $bonus to 0>>
<<set $solved to false>>
<<set $finalAnswer to null>>
<<set $ranking to []>>
<<set $rankingDone to false>>
<<set $current to null>>
<<set $currentQ to null>>
<<set $lastFollowUp to null>>
<<set $lastMain to "Start">>


:: StoryCaption
<<script>>setup.hs.caption(output)<</script>>


:: StoryMenu
<<link "Campus map">><<run setup.hs.go("Map")>><</link>>
<<link "Evidence board">><<run setup.hs.go("Evidence Board")>><</link>>
<<link "Case file">><<run setup.hs.go("Case File")>><</link>>
<<link "HEAR guide">><<run setup.hs.go("HEAR Guide")>><</link>>
<<link "Rules">><<run setup.hs.go("Rules Summary")>><</link>>


:: Start
<<script>>setup.hs.view.start(output)<</script>>


:: Hook
<<script>>setup.hs.view.hook(output)<</script>>


:: Rules
<<script>>setup.hs.view.rules(output, true)<</script>>


